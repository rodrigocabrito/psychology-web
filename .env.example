# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored and stays on your machine / in Vercel only.

# --- Resend (email notifications) ---
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Where appointment requests are emailed to (your inbox).
CONTACT_EMAIL=

# The "from" address. Use onboarding@resend.dev while testing.
# Later, verify your own domain in Resend and use e.g. site@seudominio.pt
FROM_EMAIL=onboarding@resend.dev

# --- Firebase Admin (stores requests in Firestore) ---
# From the service account JSON (Firebase Console > Project settings > Service accounts).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the surrounding quotes and the literal \n line breaks.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
